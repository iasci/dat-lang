// Shown by `dat-conformance perf`: sorting with a comparator, and by a key.
function main(): void {
  let xs: list<int> = [];
  let x = 42;
  for (const i of range(500_000)) {
    x = (x * 1103515245 + 12345) % 2147483648;
    xs.push(x % 1_000_000);
  }
  xs.sort((a, b) => b - a);
  const byLast = xs.toSortedBy((v) => v % 1000);
  print(xs[0], xs[xs.length - 1], xs[250_000], byLast[0], byLast[499_999]);
}
