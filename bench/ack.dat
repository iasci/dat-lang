// Shown by `dat-conformance perf` against bench/ack.rs, not judged: deep
// recursion with tiny frames, where two of the three calls are tail calls.
function ack(m: int, n: int): int {
  if (m == 0) {
    return n + 1;
  }
  if (n == 0) {
    return ack(m - 1, 1);
  }
  return ack(m - 1, ack(m, n - 1));
}

function main(): void {
  print(ack(3, 10));
}
