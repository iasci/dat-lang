// The methods of string (§04). Lengths and positions count bytes.

function show(label: string, value: string): void {
  print(`${label}: [${value}]`);
}

function attempt(which: int): void {
  const word = "héllo";
  try {
    if (which == 0) {
      print(word[2]);
    } else if (which == 1) {
      print(word[6]);
    } else if (which == 2) {
      print(word[-1]);
    } else if (which == 3) {
      print(word.slice(2));
    } else if (which == 4) {
      print(word.slice(0, -4));
    } else if (which == 5) {
      print("ab".repeat(-1));
    } else {
      print("ab".repeat(9223372036854775807).length);
    }
  } catch (e: RangeError) {
    print(e.toString());
  }
}

function main(): void {
  const word = "héllo";
  print(word.length, "".length, word.isEmpty(), "".isEmpty());
  print(word.includes("ll"), word.startsWith("hé"), word.endsWith("lo"), "lo" in word, "x" in word);
  print(word.indexOf("l"), word.lastIndexOf("l"), word.indexOf("x"), word.indexOf(""), word.lastIndexOf(""));
  show("slice(3)", word.slice(3));
  show("slice(1, 3)", word.slice(1, 3));
  show("slice(-3)", word.slice(-3));
  show("slice(-100, 100)", word.slice(-100, 100));
  show("slice(5, 3)", word.slice(5, 3));
  show("report.pdf", "report.pdf".slice(-3));
  show("slice(indexOf)", word.slice(word.indexOf("l")));
  show("trim", "  a b  ".trim());
  show("trimStart", "  a b  ".trimStart());
  show("trimEnd", "  a b  ".trimEnd());
  show("upper", "Straße".toUpperCase());
  show("lower", "ÀB".toLowerCase());
  show("replace", "a-b-c".replace("-", "+"));
  show("replaceAll", "a-b-c".replaceAll("-", "+"));
  show("replace missing", "abc".replace("x", "y"));
  show("repeat", "ab".repeat(3));
  show("repeat 0", "ab".repeat(0));
  show("padStart", "7".padStart(3, "0"));
  show("padStart default", "7".padStart(3));
  show("padEnd", "ab".padEnd(5, "xy"));
  show("padEnd short", "abcdef".padEnd(3));
  show("padStart multi-byte", "a".padStart(4, "é"));
  show("toString", word.toString());
  print(word[0], word[1], word[3], "hello"[4]);
  for (let i = 0; i < 7; i++) {
    attempt(i);
  }
}
