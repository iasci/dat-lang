// The methods of int and float (§04), with the exact results and every RangeError.

function int_methods(): void {
  print((-7).abs(), 3.min(-2), 3.max(-2), 1000.sqrt(), (-4).sqrt(), 10.pow(3), (-2).pow(63), 2.pow(0), 7.toFloat());
  print(42.toString(), (-7).toString() + "!");
  print(9223372036854775807.toFloat(), 9007199254740993.toFloat());
}

function float_methods(): void {
  print(2.7.floor(), (-2.7).floor(), 2.1.ceil(), (-2.1).ceil(), (-9.9).toInt(), 9.9.toInt());
  print(2.5.round(), (-2.5).round(), 0.49999999999999994.round(), (-0.5).round(), 1.5.round());
  print((-2.5).abs(), 16.0.sqrt(), (-1.0).sqrt(), 2.0.pow(0.5), 2.0.pow(10), 4.0.pow(-0.5));
  print(1.5.min(2.5), 1.5.max(2.5), (0.0 / 0.0).min(1.0), (-0.0).max(0.0), 0.0.min(-0.0));
  print(3.14159.toFixed(2), 0.125.toFixed(2), (-0.125).toFixed(2), 2.5.toFixed(0), 1.005.toFixed(2), 19.99.toFixed(0), 1.0.toFixed(3));
  print((0.0 / 0.0).toFixed(2), (1.0 / 0.0).toFixed(1), (0.0 / 0.0).isNaN(), 1.0.isNaN(), 2.5.toString());
}

/// `toInt()`, `floor()`, `ceil()` and `round()` on a division of two ints are exact.
function exact_division(): void {
  print((7 / 2).floor(), (-7 / 2).floor(), (7 / 2).ceil(), (-7 / 2).ceil(), (7 / 2).round(), (-7 / 2).round(), (-7 / 2).toInt());
  const big = 9007199254740993;
  print((big / 1).floor(), (big / 1).toInt(), (9223372036854775807 / 2).round(), (-9223372036854775807 / 3).ceil());
  const low = 3;
  const high = 10;
  print(((low + high) / 2).floor(), ((low + high) / 2).round());
}

function attempt(which: int): void {
  const nan = 0.0 / 0.0;
  const zero = 0;
  const smallest = -9223372036854775808;
  try {
    if (which == 0) {
      print(smallest.abs());
    } else if (which == 1) {
      print(10.pow(19));
    } else if (which == 2) {
      print(2.pow(-1));
    } else if (which == 3) {
      print(nan.floor());
    } else if (which == 4) {
      print(1e300.round());
    } else if (which == 5) {
      print((1.0 / 0.0).toInt());
    } else if (which == 6) {
      print((-1e19).ceil());
    } else if (which == 7) {
      print(3.14.toFixed(101));
    } else if (which == 8) {
      print((7 / zero).floor());
    } else {
      print((smallest / -1).toInt());
    }
  } catch (e: RangeError) {
    print(e.toString());
  }
}

function main(): void {
  int_methods();
  float_methods();
  exact_division();
  for (let i = 0; i < 10; i++) {
    attempt(i);
  }
  print(9223372036854775807.0.floor());
}
