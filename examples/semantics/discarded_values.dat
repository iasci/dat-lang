// A call can drop its result, and both modes still run it. A statement
// that's only a value, with no call in it, is E0305 (examples/errors/statements.dat).

function five(): int {
  print("five");
  return 5;
}

function main(): void {
  const s = "s";
  s.toString();
  s.toUpperCase();
  five();
  five() + 1;
  `${five()}`;
  five() == 5;
  for (five(); five() < 3; five()) {
    print("never");
  }
  print("ok");
}
