// Every list method of §10 that M2 implements, and the list's errors.

function main(): void {
  let nums = [3, 1, 4, 1, 5];
  nums.push(9);
  nums.push(2, 6);
  print(nums, nums.length, nums.isEmpty());
  nums.sort();
  print(nums, nums.includes(4), nums.indexOf(1), nums.lastIndexOf(1), nums.indexOf(7));
  print(nums.unique(), nums.toReversed(), nums.at(-1), nums.at(0));
  print(nums.slice(1, 3), nums.slice(-2), nums.slice(), nums.slice(10));
  print(nums.concat([7, 8]), nums.join(), nums.join(" - "));
  print(nums.map((x) => x * 2), nums.map((x, i) => i));
  print(nums.filter((x) => x % 2 == 0), nums.reduce((acc, x) => acc + x, 0));
  print(nums.flatMap((x) => [x, x]).length, nums.find((x) => x > 4, -1), nums.find((x) => x > 100, -1));
  print(nums.findIndex((x) => x > 4), nums.some((x) => x > 8), nums.every((x) => x > 0), nums.count((x) => x == 1));
  print(nums.entries().slice(0, 2), nums.zip(["a", "b", "c"]));
  print(nums.toSorted((a, b) => b - a), nums.toSortedBy((x) => -x), nums.groupBy((x) => x % 3));
  let q = ["a", "b", "c"];
  q.unshift("z");
  q.unshift("x", "y");
  print(q, q.shift(), q.pop(), q);
  q.insert(1, "new");
  q.insert(q.length, "end");
  print(q, q.removeAt(0), q.remove("new"), q.remove("none"), q);
  q.reverse();
  print(q);
  q.clear();
  print(q, q.length);

  let words = ["pear", "fig", "apple"];
  words.sortBy((w) => w.length);
  print(words);
  words.sort((a, b) => b.length - a.length);
  print(words, words.toSorted());

  let floats = [2.5, -0.0, 1.0, 0.0];
  floats.sort();
  print(floats, [1, 2.5]);

  const grid = [[1, 2], [3]];
  print(grid, grid[0][1], grid.length, [[1], [2, 3]] == [[1], [2, 3]], [1, 2] != [2, 1]);
  print(grid.flat(), [[["a"]], [["b", "c"]]].flat());

  const empty: list<string> = [];
  print(empty, empty.isEmpty(), empty.join());
  for (const bad of [5, -4]) {
    try {
      print(nums[bad]);
    } catch (e: RangeError) {
      print(e.message);
    }
  }
  try {
    print(nums.at(-10));
  } catch (e) {
    print(e);
  }
  try {
    q.pop();
  } catch (e) {
    print(e);
  }
  try {
    q.shift();
  } catch (e) {
    print(e);
  }
  try {
    q.insert(2, "x");
  } catch (e) {
    print(e);
  }
  try {
    q.removeAt(0);
  } catch (e) {
    print(e);
  }
}
