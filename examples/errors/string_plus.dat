// E0301's fix. A `+` chain that alternates strings and other values gets a
// safe template-string fix. Two ints next to each other after a string may
// mean TypeScript's "Total: 31" or the sum, so both are options.

function main(): void {
  const count = 3;
  const flag = true;
  const alternating = "fib(" + count + ") = " + 55;
  const sumFirst = count + 1 + " items";
  const ambiguous = "Total: " + count + 1;
  const twoRuns = count + 1 + " items, " + count + count + " more" + count;
  const notNumbers = "x" + flag + 1;
}
